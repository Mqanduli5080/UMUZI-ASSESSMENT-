generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brew {
  id        Int      @id @default(autoincrement())
  method    String
  beans     String
  dose      Float
  yield     Float
  time      Int
  notes     String
  createdAt DateTime @default(now())
}
